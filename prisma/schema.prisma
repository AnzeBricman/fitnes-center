generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  EXPIRING
  OVERDUE
  INACTIVE
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum ImportFormat {
  CSV
  XLSX
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
}

enum DocumentType {
  MEMBERSHIP_CONFIRMATION
  INVOICE
}

enum ExerciseSource {
  MANUAL
  API
}

model Member {
  id            String       @id @default(cuid())
  fullName      String
  email         String       @unique
  phone         String?
  dateOfBirth   DateTime?
  joinedAt      DateTime     @default(now())
  status        MemberStatus @default(ACTIVE)
  notes         String?
  subscription  Subscription?
  attendances   Attendance[]
  payments      Payment[]
  documents     Document[]
  emails        EmailLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Trainer {
  id          String    @id @default(cuid())
  fullName    String
  email       String    @unique
  phone       String?
  specialty   String
  bio         String?
  workouts    Workout[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Workout {
  id            String        @id @default(cuid())
  title         String
  description   String?
  scheduledAt   DateTime
  durationMin   Int
  capacity      Int
  level         WorkoutLevel  @default(BEGINNER)
  trainerId     String
  trainer       Trainer       @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  attendances   Attendance[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([trainerId])
}

model SubscriptionPlan {
  id             String         @id @default(cuid())
  name           String         @unique
  priceCents     Int
  durationDays   Int
  description    String?
  stripePriceId  String?
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Subscription {
  id          String            @id @default(cuid())
  memberId    String            @unique
  planId      String
  startDate   DateTime
  endDate     DateTime
  active      Boolean           @default(true)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]
  documents   Document[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([planId])
  @@index([endDate])
}

model Attendance {
  id          String    @id @default(cuid())
  memberId    String
  workoutId   String
  checkedInAt DateTime  @default(now())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workout     Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([memberId, workoutId])
  @@index([checkedInAt])
}

model Payment {
  id                      String          @id @default(cuid())
  memberId                String
  subscriptionId          String?
  amountCents             Int
  currency                String          @default("EUR")
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  description             String?
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?         @unique
  paidAt                  DateTime?
  member                  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription            Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([memberId, status])
  @@index([subscriptionId])
}

model ImportJob {
  id         String       @id @default(cuid())
  fileName   String
  format     ImportFormat
  status     ImportStatus @default(PENDING)
  rowCount   Int          @default(0)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model EmailLog {
  id          String      @id @default(cuid())
  memberId     String?
  recipient    String
  subject      String
  templateName String
  body         String
  status       EmailStatus @default(DRAFT)
  provider     String?
  sentAt       DateTime?
  member       Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([recipient, status])
}

model Document {
  id             String       @id @default(cuid())
  memberId        String?
  subscriptionId  String?
  type           DocumentType
  title          String
  content        String
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Exercise {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  imageUrl    String?
  targetArea  String
  source      ExerciseSource @default(MANUAL)
  externalId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([targetArea])
}
