generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  EXPIRING
  OVERDUE
  INACTIVE
}

enum Gender {
  UNSPECIFIED
  MALE
  FEMALE
  OTHER
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  ADMIN
  STAFF
  TRAINER
  MEMBER
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum AttendanceMethod {
  MANUAL
  TERMINAL
  PORTAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum ImportFormat {
  CSV
  XLSX
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
}

enum DocumentType {
  MEMBERSHIP_CONFIRMATION
  INVOICE
}

enum ExerciseSource {
  MANUAL
  API
}

enum TrainingRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ChatSenderRole {
  MEMBER
  TRAINER
  ADMIN
}

model Member {
  id            String       @id @default(cuid())
  fullName      String
  email         String       @unique
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  gender        Gender?
  joinedAt      DateTime     @default(now())
  status        MemberStatus @default(ACTIVE)
  notes         String?
  subscriptions Subscription[]
  attendances   Attendance[]
  payments      Payment[]
  documents     Document[]
  emails        EmailLog[]
  trainingRequests TrainingRequest[]
  user          User?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Trainer {
  id          String    @id @default(cuid())
  fullName    String
  email       String    @unique
  phone       String?
  specialty   String
  bio         String?
  status      TrainerStatus @default(ACTIVE)
  startedAt   DateTime?
  workouts    Workout[]
  trainingRequests TrainingRequest[]
  user        User?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Workout {
  id            String        @id @default(cuid())
  title         String
  description   String?
  scheduledAt   DateTime
  durationMin   Int
  capacity      Int
  level         WorkoutLevel  @default(BEGINNER)
  status        WorkoutStatus @default(SCHEDULED)
  location      String?
  type          String?
  trainerId     String
  trainer       Trainer       @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  attendances   Attendance[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([trainerId])
}

model SubscriptionPlan {
  id             String         @id @default(cuid())
  name           String         @unique
  priceCents     Int
  durationDays   Int
  description    String?
  stripePriceId  String?
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Subscription {
  id          String            @id @default(cuid())
  memberId    String
  planId      String
  startDate   DateTime
  endDate     DateTime
  active      Boolean           @default(true)
  status      SubscriptionStatus @default(ACTIVE)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]
  documents   Document[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([planId])
  @@index([endDate])
  @@index([memberId])
}

model Attendance {
  id          String    @id @default(cuid())
  memberId    String
  workoutId   String?
  checkedInAt DateTime  @default(now())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workout     Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  method      AttendanceMethod @default(MANUAL)

  @@unique([memberId, workoutId])
  @@index([checkedInAt])
}

model Payment {
  id                      String          @id @default(cuid())
  memberId                String
  subscriptionId          String?
  amountCents             Int
  currency                String          @default("EUR")
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  description             String?
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?         @unique
  paidAt                  DateTime?
  member                  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription            Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([memberId, status])
  @@index([subscriptionId])
}

model ImportJob {
  id         String       @id @default(cuid())
  fileName   String
  format     ImportFormat
  status     ImportStatus @default(PENDING)
  rowCount   Int          @default(0)
  note       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model EmailLog {
  id          String      @id @default(cuid())
  memberId     String?
  recipient    String
  subject      String
  templateName String
  body         String
  status       EmailStatus @default(DRAFT)
  provider     String?
  sentAt       DateTime?
  member       Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([recipient, status])
}

model Document {
  id             String       @id @default(cuid())
  memberId        String?
  subscriptionId  String?
  type           DocumentType
  title          String
  content        String
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Exercise {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  imageUrl    String?
  targetArea  String
  source      ExerciseSource @default(MANUAL)
  externalId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([targetArea])
}

model TrainingRequest {
  id               String                @id @default(cuid())
  memberId         String
  trainerId        String
  preferredAt      DateTime
  durationMin      Int                   @default(60)
  note             String?
  status           TrainingRequestStatus @default(PENDING)
  trainerAvailable Boolean               @default(false)
  member           Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer          Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  messages         TrainingRequestMessage[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([memberId, createdAt])
  @@index([trainerId, preferredAt])
  @@index([status])
}

model TrainingRequestMessage {
  id          String         @id @default(cuid())
  requestId   String
  senderRole  ChatSenderRole
  senderName  String
  body        String
  request     TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([requestId, createdAt])
}

model Settings {
  id           String   @id @default("default")
  gymName      String   @default("Fitnes Center")
  address      String?
  email        String?
  phone        String?
  logoUrl      String?
  reminderDays Int      @default(7)
  currency     String   @default("EUR")
  pdfFooter    String?
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpFrom     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  memberId     String?  @unique
  trainerId    String?  @unique
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  trainer      Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
